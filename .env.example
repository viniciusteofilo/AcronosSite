# Copy to .env.local (development) and fill in. Never commit real values.

# PostgreSQL connection string (Neon in staging/production, local Postgres in development)
DATABASE_URL=postgres://acronos:acronos_dev@localhost:5432/acronos_dev

# Separate database used only by automated tests (it is wiped on every run)
TEST_DATABASE_URL=postgres://acronos:acronos_dev@localhost:5432/acronos_test

# Secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the site (no trailing slash). The official domain lives here,
# so moving from acronos.com.br to a new domain is a configuration change.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Images. Development stores uploads in ./.media (git-ignored) and serves them at /media.
# Production (Phase 07): MEDIA_DRIVER=r2 and the public R2 URL below.
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=.media
NEXT_PUBLIC_MEDIA_BASE_URL=

# Payments (PLANNED - Phase 05). Use sandbox/test keys only until accounts are approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
